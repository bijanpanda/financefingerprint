# ── LOCAL / TEST — point these at the TEST Firebase project ──────────────────
# Never put production Firebase values here. Local dev and the `test` branch's
# Vercel Preview deployments both use this plain (non-regional) config block —
# see src/lib/firebase/firebaseRegion.ts, which falls back to these vars when
# the region-specific ones below are unset. That's what makes one shared test
# project cover both the India and US code paths.
#
# Production values for these same variable names live ONLY in the Vercel
# dashboard, scoped to the "Production" environment — never in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Admin SDK — TEST project's service account (Project Settings → Service
#    Accounts → Generate new private key). Leave FIREBASE_SERVICE_ACCOUNT_PATH
#    pointing at a local JSON file instead if you prefer; either works locally.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── PRODUCTION ONLY — set these in the Vercel dashboard's "Production"
#    environment, scoped to main. Leave blank locally and in Preview so the
#    fallback above (test project) is what actually gets used everywhere else.
# ── Regional Firebase — India (financialfingerprint-in) ───────────────────────
NEXT_PUBLIC_FIREBASE_IN_API_KEY=
NEXT_PUBLIC_FIREBASE_IN_AUTH_DOMAIN=financialfingerprint-in.firebaseapp.com
NEXT_PUBLIC_FIREBASE_IN_PROJECT_ID=financialfingerprint-in
NEXT_PUBLIC_FIREBASE_IN_STORAGE_BUCKET=financialfingerprint-in.appspot.com
NEXT_PUBLIC_FIREBASE_IN_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_IN_APP_ID=

# ── Regional Firebase — United States (financialfingerprint-us) ───────────────
NEXT_PUBLIC_FIREBASE_US_API_KEY=
NEXT_PUBLIC_FIREBASE_US_AUTH_DOMAIN=financialfingerprint-us.firebaseapp.com
NEXT_PUBLIC_FIREBASE_US_PROJECT_ID=financialfingerprint-us
NEXT_PUBLIC_FIREBASE_US_STORAGE_BUCKET=financialfingerprint-us.appspot.com
NEXT_PUBLIC_FIREBASE_US_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_US_APP_ID=

# ── PII Encryption key (AES-256-GCM) — generate with: openssl rand -hex 32 ───
ENCRYPTION_KEY=

# ── Resend (welcome email) ────────────────────────────────────────────────────
# Locally / in test: only send to delivered@resend.dev, bounced@resend.dev, or
# complained@resend.dev — never a real address — so test runs can't email an
# actual person.
RESEND_API_KEY=
EMAIL_FROM=welcome@financialfingerprint.in

# ── Anthropic (Customer Profiling — AI synthesis, server-side only) ──────────
# Get a key at https://console.anthropic.com/settings/keys
# If unset, POST /api/profile/synthesize automatically falls back to the local
# template-based synthesis so the app keeps working without a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
